{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs"
    },
    "ownus": {
      "root": "ownus",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "ORION_API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "ownus"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/webhooks",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/v1/cron/exports",
      "schedule": "10 2 * * *"
    },
    {
      "path": "/api/v1/cron/queues",
      "schedule": "20 2 * * *"
    },
    {
      "path": "/api/v1/cron/credit-rollover",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/v1/cron/privacy",
      "schedule": "40 2 * * *"
    },
    {
      "path": "/api/v1/cron/token-cleanup",
      "schedule": "50 2 * * *"
    },
    {
      "path": "/api/v1/cron/queue-prune",
      "schedule": "0 3 * * *"
    }
  ]
}
