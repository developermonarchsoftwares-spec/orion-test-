# ==============================================================================
# ORION ENTERPRISE PLATFORM — COMPLETE PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
APP_NAME=Orion Lead Intelligence Platform
APP_URL=https://orion-api-snowy.vercel.app
CORS_ORIGINS=https://orion-api-snowy.vercel.app,http://localhost:3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT (NEXT.JS PUBLIC VARIABLES)
# ------------------------------------------------------------------------------
# Public URL of the backend API used by the browser client
NEXT_PUBLIC_API_URL=https://orion-api-snowy.vercel.app/api/v1
# Public website base URL
NEXT_PUBLIC_APP_URL=https://orion-api-snowy.vercel.app
# Upstream API URL for Vercel serverless proxy route
BACKEND_API_URL=https://orion-api-snowy.vercel.app/api/v1

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL & DRIZZLE ORM)
# Any PostgreSQL provider (managed or self-hosted). Use the provider's DIRECT (non-pooled) connection string:
# migrations take advisory locks. The server certificate is always verified for a remote host; sslmode in the URL cannot weaken it.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@db.example.com:5432/orion_db?sslmode=require
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000



# ------------------------------------------------------------------------------
# 5. HIGH-PERFORMANCE SEARCH ENGINE (TYPESENSE)
# Powers sub-50ms search and multi-facet filtering across 1.2M+ business records
# Compatible with Typesense Cloud or self-hosted Typesense cluster
# ------------------------------------------------------------------------------
TYPESENSE_NODES=xxx.typesense.net
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=your_typesense_search_admin_api_key
TYPESENSE_CONNECTION_TIMEOUT_SECONDS=5

# ------------------------------------------------------------------------------
# 6. JWT AUTHENTICATION & SECURITY TOKENS
# Used to sign session tokens for Orion subscribers and corporate admins
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=generate_a_secure_64_char_random_string_for_access_tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate_a_secure_64_char_random_string_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=orion-api
JWT_AUDIENCE=orion-client

# Account identity flows (password reset, e-mail verification, MFA)
# Public URL of the web app; reset / verify links in e-mails point here.
WEB_APP_URL=https://app.example.com
# Mail transport for account e-mails: `webhook` POSTs {to, subject, text, html?} as JSON to MAIL_WEBHOOK_URL.
# The sign-up verification CODE is sent through this transport (API) or through RESEND_API_KEY (web gateway). In production a code is
# never written to the log, so without a working transport nobody can register.
# Production has NO default transport: without one, reset / verification e-mails are NOT sent.
MAIL_TRANSPORT=webhook
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
# Set to true to block sign-in until the e-mail address is verified (default false = auto-verified on sign-up).
REQUIRE_EMAIL_VERIFICATION=false
# Sign-up requires a 6-digit code sent to the address typed. ALWAYS ON in production: this setting is ignored there. Outside production
# only, REQUIRE_REGISTRATION_OTP=false turns it off (local development without a mail relay).
REQUIRE_REGISTRATION_OTP=true
# Optional: key for hashing codes (defaults to a key derived from JWT_ACCESS_SECRET; changing it invalidates codes in flight).
EMAIL_OTP_SECRET=
# Optional: name shown in the code e-mail.
APP_NAME=Orion
# Optional: key for sealing MFA TOTP seeds at rest (defaults to a key derived from JWT_ACCESS_SECRET; changing it
# invalidates enrolled authenticators). Issuer name shown in authenticator apps.
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Orion

# Third-party integrations (webhooks, CRM): see docs/INTEGRATIONS.md
# Optional key for sealing webhook signing secrets and CRM tokens (default: derived from JWT_ACCESS_SECRET).
INTEGRATIONS_ENCRYPTION_KEY=
# Public base URL of this API, used to build the callback URL sent to webhook receivers.
API_PUBLIC_URL=https://api.example.com

# ------------------------------------------------------------------------------
# 7. S3-COMPATIBLE OBJECT STORAGE
# Stores uploaded CSV/Excel import batches, data exports, and business assets
# Compatible with Cloudflare R2, AWS S3, or MinIO
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=r2
STORAGE_BUCKET=orion-production-assets
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your_cloudflare_r2_or_s3_access_key
STORAGE_SECRET_KEY=your_cloudflare_r2_or_s3_secret_key
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_URL_PREFIX=https://assets.yourdomain.com

# ------------------------------------------------------------------------------
# 8. PAYMENT GATEWAY (RAZORPAY)
# Powers platform wallet credit purchases, package top-ups, and auto-invoicing
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signing_secret
# `live` creates orders at Razorpay, confirms payments with it, and sends refunds through it. Unset = simulated (no real checkout, no refunds).
RAZORPAY_API_MODE=
# Invoice header (see docs/BILLING.md)
INVOICE_SELLER_NAME=
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_TAX_ID=

# ------------------------------------------------------------------------------
# 9. SINGLE SIGN-ON (OAUTH 2.0 PROVIDERS)
# Enables 1-click login with Google and Microsoft Azure AD
# ------------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://orion-api-snowy.vercel.app/api/v1/auth/google/callback

# Microsoft Azure Portal -> Azure Active Directory -> App Registrations
MICROSOFT_CLIENT_ID=your-azure-ad-application-client-id
MICROSOFT_CLIENT_SECRET=your-azure-ad-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=https://orion-api-snowy.vercel.app/api/v1/auth/microsoft/callback

# ------------------------------------------------------------------------------
# 10. TRANSACTIONAL EMAIL & REAL OTP DISPATCH
# Required to send real 6-digit OTP codes and welcome emails to user inboxes
# Compatible with Resend, SendGrid, Postmark, Amazon SES, or custom SMTP
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_FROM="Monarch Security" <security@monarchsoftwares.com>
# Or direct API Key if using Resend SDK:
RESEND_API_KEY=re_your_resend_api_key

# ------------------------------------------------------------------------------
# 11. RATE LIMITING & SECURITY GUARDS
# ------------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ------------------------------------------------------------------------------
# API PROTECTION / TRAFFIC CONTROL (see docs/API_PROTECTION.md). All optional; defaults shown.
# ------------------------------------------------------------------------------
TRAFFIC_CONTROL_ENABLED=true
# If customers reach the API through a gateway, set the header your proxy fills with the REAL client address
# (only when the API is reachable ONLY through that proxy), or add the gateway's addresses as ALLOW rules.
TRAFFIC_TRUSTED_IP_HEADER=
RATE_LIMIT_IP_BURST_PER_SECOND=25
RATE_LIMIT_IP_PER_HOUR=3000
RATE_LIMIT_USER_PER_MINUTE=120
RATE_LIMIT_USER_PER_DAY=5000
RATE_LIMIT_USER_BURST_PER_SECOND=20
RATE_LIMIT_USER_MAX_CONCURRENT=10
ABUSE_STRIKE_THRESHOLD=10
LOGIN_LOCK_AFTER_FAILURES=8
LOGIN_LOCK_MINUTES=15
# Comma-separated regular expressions of extra user agents to refuse.
BLOCKED_USER_AGENTS=
# Human check at sign-up / reset (and at sign-in after repeated failures): turnstile | hcaptcha | recaptcha
CAPTCHA_PROVIDER=
CAPTCHA_SECRET_KEY=
CAPTCHA_FAIL_OPEN=false

# ------------------------------------------------------------------------------
# MONITORING AND OBSERVABILITY (see docs/OBSERVABILITY.md). All optional.
# ------------------------------------------------------------------------------
LOG_FORMAT=json
LOG_LEVEL=info
SLOW_REQUEST_MS=1000
# Error tracking (Sentry or a Sentry-compatible server)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
# Distributed tracing: export sampled traces over OTLP/HTTP to a collector
TRACE_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=orion-api
# Bearer token (16+ characters) the Prometheus scraper sends to /api/v1/metrics. Without it only an administrator can read metrics.
METRICS_TOKEN=
# Vercel Cron secret (32+ random characters). Vercel sends it as `Authorization: Bearer $CRON_SECRET` to the /api/v1/cron/* routes that run the
# background jobs on Vercel. Unset = those routes answer 503 and no job runs there.
CRON_SECRET=
DB_SLOW_QUERY_MS=500
# Slack-compatible webhook that receives alerts when something starts / stops failing
MONITORING_ALERT_WEBHOOK_URL=
APP_VERSION=
GIT_SHA=

# ------------------------------------------------------------------------------
# HEALTH CHECKS (see docs/HEALTH_CHECKS.md). All optional; defaults shown.
# ------------------------------------------------------------------------------
HEALTH_CHECK_TIMEOUT_MS=2000
HEALTH_CACHE_MS=2000
LIVENESS_MAX_LAG_MS=5000
# Seconds to keep serving (as "not ready") after a shutdown signal, so the load balancer drains the instance first
HEALTH_SHUTDOWN_DRAIN_SECONDS=0
READINESS_REQUIRES_STORAGE=false
# Redis is not used by the application today. Leave empty unless you run one; the health check then reports "not configured".
# REDIS_URL=redis://:password@host:6379/0   (rediss:// for TLS)   or the separate variables:
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=
REDIS_TLS=
REDIS_REQUIRED=false
