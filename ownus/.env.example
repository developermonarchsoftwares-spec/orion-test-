# Environment variables for the WEB service (the Next.js app in /ownus).
# Copy to .env.local for local work. On Vercel set them in Project Settings -> Environment Variables (Production AND Preview); in
# services mode the project's variables are shared by both services (apps/api reads its own set, see .env.production.example).
# Values here are empty placeholders only. Never commit real values and never prefix a secret with NEXT_PUBLIC_.

# --- How the web app finds the API ------------------------------------------------------------------------------------------
# On Vercel (root vercel.json, services mode) do NOT set these: the `ownus` service has a binding to the `api` service and Vercel injects
# ORION_API_URL (the API's internal URL base) by itself. Never set ORION_API_URL by hand on Vercel.
# Everywhere else (local development, Docker, an API hosted elsewhere) set BACKEND_API_URL to the full API URL INCLUDING /api/v1:
BACKEND_API_URL=
# Leave NEXT_PUBLIC_API_URL empty so the browser calls the same origin (/api/v1, handled by this app). Set it only to make the browser
# call a different API origin directly (it is then added to the CSP connect-src).
NEXT_PUBLIC_API_URL=

# --- Required --------------------------------------------------------------------------------------------------------------
# Public base URL of this web app, e.g. https://app.example.com (used for links and OAuth callbacks).
NEXT_PUBLIC_APP_URL=

# PostgreSQL used directly by the web gateway. Use a remote provider's connection string; the server certificate is always verified.
# GATEWAY_DATABASE_URL (a least-privilege role) wins over DATABASE_URL when set.
DATABASE_URL=
GATEWAY_DATABASE_URL=

# Token signing. These MUST be the same values the API uses, at least 32 random characters, and NOT any value that was ever committed
# or published: in production the gateway refuses placeholder-shaped and publicly known secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=orion-api
JWT_AUDIENCE=

# --- Optional --------------------------------------------------------------------------------------------------------------
# Admin session lifetime in seconds (default 12 hours).
ADMIN_SESSION_TTL_SECONDS=
# Sign-up and admin verification e-mails sent by the gateway (without these, nobody can receive a code in production).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Google sign-in. GOOGLE_CALLBACK_URL must exactly match a redirect URI registered in the Google console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# CAPTCHA (Cloudflare Turnstile) on sign-in and sign-up. MANDATORY in production: both values must be set there, or sign-in and sign-up are refused.
# Outside production, leaving both empty turns it off (local development).
# Cloudflare test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
