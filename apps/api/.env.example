# ==============================================
# ORION ENTERPRISE BACKEND ENVIRONMENT CONFIG
# ==============================================

# Application
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=Orion Backend API
APP_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# PostgreSQL & Drizzle ORM
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orion_db
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
# server-side limits on every pooled connection (0 = off): statement, idle-in-transaction, lock wait
DB_STATEMENT_TIMEOUT_MS=60000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
DB_LOCK_TIMEOUT_MS=5000



# Typesense Search Engine
TYPESENSE_NODES=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz123_orion_typesense_master_key
TYPESENSE_CONNECTION_TIMEOUT_SECONDS=5

# JWT Authentication
JWT_ACCESS_SECRET=orion_super_secret_access_jwt_key_2026_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=orion_super_secret_refresh_jwt_key_2026_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=orion-api
JWT_AUDIENCE=orion-client

# Storage Provider (s3, r2, minio)
STORAGE_PROVIDER=minio
STORAGE_BUCKET=orion-assets
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL_PREFIX=http://localhost:9000/orion-assets

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=info

# OAuth & Enterprise Identity (Sprint 16)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://orion-api-snowy.vercel.app/api/v1/auth/google/callback

MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/v1/auth/microsoft/callback

# Razorpay Standard Checkout. Test keys start with rzp_test_. The secret is server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# live = real Razorpay orders (also for test keys); unset = local orders, no real checkout
RAZORPAY_API_MODE=live

# CAPTCHA (Cloudflare Turnstile): /auth/login and /auth/send-otp require a valid captchaToken. MANDATORY in production (an unset secret there
# refuses the request); outside production, empty = off.
TURNSTILE_SECRET_KEY=
