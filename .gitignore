# Dependencies
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Production / Build outputs
dist/
**/dist/
.next/
**/.next/
out/
**/out/
build/
**/build/

# Environment files
.env
**/.env
.env.local
**/.env.local
.env.development.local
.env.test.local
.env.production.local
!**/.env.example

# Logs
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts

# Testing
coverage/
**/coverage/
playwright-report/
test-results/
blob-report/

# IDE & OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

.vercel
.env*.local

# backups
ops/backup/backup.env
ops/backup/backups/

# scratch scripts: ad-hoc database probes tend to hold connection strings; keep them out of version control
scratch/
ownus/scratch/
ownus/scratch_*.js
# the local-only database helper the scratch scripts and their guard test depend on must stay tracked
!ownus/scratch_target.js

# Any other local env file (e.g. .env.staging) may hold real secrets; templates (*.example) stay tracked.
.env.*
**/.env.*
!.env.*.example
!**/.env.*.example
